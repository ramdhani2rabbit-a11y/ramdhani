rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Pure token check without DB lookup for list queries
    function isBootstrappedAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'ramdhani2rabbit@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidEmail(email) {
      return email is string && email.size() >= 5 && email.size() <= 150 && email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    // Validation Blueprint: PortfolioProject
    function isValidProject(data) {
      return data.keys().hasAll([
          'title', 'category', 'year', 'systemSpec', 'summary',
          'challenge', 'solution', 'standardRef', 'role',
          'components', 'isPublished', 'authorUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'category', 'year', 'systemSpec', 'summary',
          'challenge', 'solution', 'standardRef', 'role',
          'components', 'isPublished', 'authorUid', 'createdAt', 'updatedAt'
        ])
        && data.title is string && data.title.size() >= 5 && data.title.size() <= 160
        && data.category in ['Panel & Distribusi', 'Otomasi PLC', 'Energi Terbarukan', 'Proteksi & Uji']
        && data.year is string && data.year.size() == 4 && data.year.matches('^20[0-9]{2}$')
        && data.systemSpec is string && data.systemSpec.size() >= 3 && data.systemSpec.size() <= 80
        && data.summary is string && data.summary.size() >= 10 && data.summary.size() <= 600
        && data.challenge is string && data.challenge.size() >= 10 && data.challenge.size() <= 800
        && data.solution is string && data.solution.size() >= 10 && data.solution.size() <= 800
        && data.standardRef is string && data.standardRef.size() >= 3 && data.standardRef.size() <= 120
        && data.role is string && data.role.size() >= 3 && data.role.size() <= 120
        && data.components is list && data.components.size() <= 12
        && (data.components.size() == 0 || (data.components[0] is string && data.components[0].size() <= 120))
        && data.isPublished is bool
        && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: ContactInquiry
    function isValidInquiry(data) {
      return data.keys().hasAll([
          'senderUid', 'senderName', 'senderEmail', 'subject',
          'message', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'senderUid', 'senderName', 'senderEmail', 'subject',
          'message', 'status', 'createdAt', 'updatedAt'
        ])
        && data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128
        && data.senderName is string && data.senderName.size() >= 2 && data.senderName.size() <= 100
        && isValidEmail(data.senderEmail)
        && data.subject is string && data.subject.size() >= 2 && data.subject.size() <= 160
        && data.message is string && data.message.size() >= 5 && data.message.size() <= 2000
        && data.status in ['baru', 'dibalas', 'arsip']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: SavedCalculation
    function isValidCalculation(data) {
      return data.keys().hasAll([
          'ownerUid', 'label', 'phase', 'powerKw', 'powerFactor',
          'nominalCurrent', 'recommendedMcb', 'cableRecommendation', 'createdAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'label', 'phase', 'powerKw', 'powerFactor',
          'nominalCurrent', 'recommendedMcb', 'cableRecommendation', 'createdAt'
        ])
        && data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.label is string && data.label.size() >= 2 && data.label.size() <= 100
        && data.phase in ['3-phase', '1-phase']
        && data.powerKw is number && data.powerKw > 0 && data.powerKw <= 500
        && data.powerFactor is number && data.powerFactor >= 0.5 && data.powerFactor <= 1.0
        && data.nominalCurrent is number && data.nominalCurrent > 0 && data.nominalCurrent <= 2000
        && data.recommendedMcb is number && data.recommendedMcb >= 6 && data.recommendedMcb <= 1600
        && data.cableRecommendation is string && data.cableRecommendation.size() >= 3 && data.cableRecommendation.size() <= 60
        && data.createdAt is timestamp;
    }

    // Collection: /projects/{projectId}
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && (existing().isPublished == true || isAdmin());
      allow list: if existing().isPublished == true || isBootstrappedAdmin();
      allow create: if isValidId(projectId)
        && isAdmin()
        && isValidProject(incoming())
        && incoming().authorUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(projectId)
        && isAdmin()
        && isValidProject(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'category', 'year', 'systemSpec', 'summary',
          'challenge', 'solution', 'standardRef', 'role',
          'components', 'isPublished', 'updatedAt'
        ]);
      allow delete: if isValidId(projectId) && isAdmin();
    }

    // Collection: /inquiries/{inquiryId} (PII Isolated)
    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId)
        && isVerifiedUser()
        && (existing().senderUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser()
        && (existing().senderUid == request.auth.uid || isBootstrappedAdmin());
      allow create: if isValidId(inquiryId)
        && isVerifiedUser()
        && isValidInquiry(incoming())
        && incoming().senderUid == request.auth.uid
        && incoming().status == 'baru'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(inquiryId)
        && isVerifiedUser()
        && isValidInquiry(incoming())
        && incoming().senderUid == existing().senderUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Admin updates status
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          // Action 2: Sender edits subject/message while still 'baru'
          (existing().senderUid == request.auth.uid
            && existing().status == 'baru'
            && incoming().status == 'baru'
            && incoming().diff(existing()).affectedKeys().hasOnly(['subject', 'message', 'updatedAt']))
        );
      allow delete: if isValidId(inquiryId)
        && isVerifiedUser()
        && (isAdmin() || (existing().senderUid == request.auth.uid && existing().status == 'baru'));
    }

    // Collection: /calculations/{calcId}
    match /calculations/{calcId} {
      allow get: if isValidId(calcId)
        && isVerifiedUser()
        && existing().ownerUid == request.auth.uid;
      allow list: if isVerifiedUser()
        && existing().ownerUid == request.auth.uid;
      allow create: if isValidId(calcId)
        && isVerifiedUser()
        && isValidCalculation(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(calcId)
        && isVerifiedUser()
        && existing().ownerUid == request.auth.uid;
    }

    // Collection: /admins/{userId}
    match /admins/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      allow list: if false;
      allow write: if false;
    }
  }
}
